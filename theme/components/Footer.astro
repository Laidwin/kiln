---
/**
 * Starlight's footer, followed by a discreet "Built with Kiln" credit.
 * Only registered when the `poweredBy` theme option is on (the default).
 */
import Default from '@astrojs/starlight/components/Footer.astro';

const labels: Record<string, string> = { en: 'Built with Kiln', fr: 'Réalisé avec Kiln' };
const label = labels[Astro.locals.starlightRoute.lang] ?? labels.en;
---

<Default />
<a class="th-powered-by" href="https://github.com/Laidwin/kiln">
	<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
		<path d="M6 28V15a10 10 0 0 1 20 0v13M4 28h24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
		<path d="M16 12c2.6 2.7 3.8 4.8 3.8 7a3.8 3.8 0 0 1-7.6 0c0-1.3.5-2.4 1.4-3.5.4 1.1 1 1.8 1.8 2 .1-2 .3-3.5.6-5.5Z" fill="currentColor"></path>
	</svg>
	{label}
</a>

<style>
	.th-powered-by {
		display: flex;
		align-items: center;
		gap: 0.5em;
		width: fit-content;
		margin: 2.5rem auto 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.th-powered-by:hover {
		color: var(--sl-color-white);
	}
	.th-powered-by svg {
		width: 1.1em;
		height: 1.1em;
		color: var(--sl-color-accent);
	}
</style>
