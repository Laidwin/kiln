---
/**
 * Python API reference, generated by the Kiln runner from a griffe dump (docs.yml `api.python`).
 * /api/ lists the modules; /api/<package>/<module>/ documents one module.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Badge, Code } from '@astrojs/starlight/components';
import Attributes from '../../components/kiln-api/Attributes.astro';
import Details from '../../components/kiln-api/Details.astro';
import Member from '../../components/kiln-api/Member.astro';
import Parts from '../../components/kiln-api/Parts.astro';
import model from '../../kiln-api.json';

export function getStaticPaths() {
	return [{ params: { slug: undefined }, props: { page: null } }, ...model.pages.map((page) => ({ params: { slug: page.slug }, props: { page } }))];
}

const { page } = Astro.props;
const { labels } = model;
const strip = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&amp;/g, '&');

const headings = [];
if (page) {
	if (page.submodules.length) headings.push({ depth: 2, slug: 'modules', text: labels.modules });
	for (const cls of page.classes) {
		headings.push({ depth: 2, slug: cls.anchor, text: cls.name });
		for (const m of [...cls.properties, ...cls.methods]) headings.push({ depth: 3, slug: m.anchor, text: m.name });
	}
	if (page.functions.length) {
		headings.push({ depth: 2, slug: 'functions', text: labels.functions });
		for (const fn of page.functions) headings.push({ depth: 3, slug: fn.anchor, text: fn.name });
	}
	if (page.attributes.length) headings.push({ depth: 2, slug: 'attributes', text: labels.attributes });
}

const frontmatter = page
	? { title: page.path, description: strip(page.summary) || undefined }
	: { title: labels.reference, description: labels.overview };
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
	{
		!page && (
			<ul class="kiln-api-modules">
				{model.pages.map((p) => (
					<li style={`--depth: ${p.path.split('.').length - 1}`}>
						<a href={p.url}>
							<code>{p.path}</code>
						</a>
						{p.summary && <span set:html={p.summary} />}
					</li>
				))}
			</ul>
		)
	}
	{
		page && (
			<>
				<Parts parts={page.parts} />
				<Details labels={labels} notes={page.notes} />

				{page.submodules.length > 0 && (
					<>
						<h2 id="modules">{labels.modules}</h2>
						<ul class="kiln-api-modules">
							{page.submodules.map((m) => (
								<li>
									<a href={m.url}>
										<code>{m.path}</code>
									</a>
									{m.summary && <span set:html={m.summary} />}
								</li>
							))}
						</ul>
					</>
				)}

				{page.classes.map((cls) => (
					<section class="kiln-api-class">
						<h2 id={cls.anchor}>
							<code>{cls.name}</code>
							{cls.labels.map((label) => (
								<Badge text={label} variant="note" size="small" />
							))}
						</h2>
						<Code code={cls.signature} lang="python" />
						{cls.bases.length > 0 && (
							<p class="kiln-api-attr">
								{labels.bases}: <Fragment set:html={cls.bases.map((b) => `<code>${b}</code>`).join(', ')} />
							</p>
						)}
						<Parts parts={cls.parts} />
						<Details labels={labels} params={cls.params} raises={cls.raises} notes={cls.notes} />
						{cls.source && (
							<a class="kiln-api-source" href={cls.source}>
								{labels.source}
							</a>
						)}

						{cls.attributes.length > 0 && (
							<div class="kiln-api-block">
								<p class="kiln-api-heading">{labels.attributes}</p>
								<Attributes attributes={cls.attributes} labels={labels} />
							</div>
						)}
						{[...cls.properties, ...cls.methods].map((member) => (
							<Member member={member} labels={labels} level={3} />
						))}
					</section>
				))}

				{page.functions.length > 0 && (
					<>
						<h2 id="functions">{labels.functions}</h2>
						{page.functions.map((fn) => (
							<Member member={fn} labels={labels} level={3} />
						))}
					</>
				)}

				{page.attributes.length > 0 && (
					<>
						<h2 id="attributes">{labels.attributes}</h2>
						<Attributes attributes={page.attributes} labels={labels} />
					</>
				)}
			</>
		)
	}
</StarlightPage>
