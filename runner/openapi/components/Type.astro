---
/** A field type; named schemas link to their page. */
interface TypeInfo {
	text: string;
	link?: string;
	parts?: TypeInfo[];
}
interface Props {
	type?: TypeInfo;
}
const { type } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (link: string) => `${base}${link}`;
---

{
	type &&
		(type.parts && type.parts.length > 1 ? (
			<span class="kiln-oa-type">
				{type.parts.map((p, i) => (
					<>
						{i > 0 && ' | '}
						{p.link ? <a href={href(p.link)}>{p.text}</a> : p.text}
					</>
				))}
			</span>
		) : type.link ? (
			<a class="kiln-oa-type" href={href(type.link)}>
				{type.text}
			</a>
		) : (
			<span class="kiln-oa-type">{type.text}</span>
		))
}
