---
/**
 * OpenAPI reference, generated by the Kiln runner from docs.yml `api.openapi`:
 * /api/ introduces the API, /api/<tag>/<operation>/ documents one operation with its code samples,
 * /api/schemas/<name>/ documents one schema.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Badge, Code, TabItem, Tabs } from '@astrojs/starlight/components';
import Fields from '/src/components/kiln-openapi/Fields.astro';
import Parts from '/src/components/kiln-openapi/Parts.astro';
import Type from '/src/components/kiln-openapi/Type.astro';
import model from '/src/kiln-openapi.json';

export function getStaticPaths() {
	return model.pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const { labels } = model;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (link: string) => `${base}${link}`;
const method = (m: string) => m.toUpperCase();

const paramSections = page.kind === 'operation'
	? ([
			['path', labels.pathParams],
			['query', labels.queryParams],
			['header', labels.headerParams],
			['cookie', labels.cookieParams],
		] as const).filter(([key]) => page.params[key].length)
	: [];
const examples = page.kind === 'operation' ? page.responses.filter((r) => r.example) : [];

const headings =
	page.kind === 'operation'
		? [
				...paramSections.map(([key, label]) => ({ depth: 2, slug: `${key}-parameters`, text: label })),
				...(page.body ? [{ depth: 2, slug: 'request-body', text: labels.body }] : []),
				{ depth: 2, slug: 'responses', text: labels.responses },
			]
		: page.kind === 'introduction'
			? [
					...page.headings,
					...(page.servers.length ? [{ depth: 2, slug: 'base-url', text: labels.baseUrl }] : []),
					...(page.auth.length ? [{ depth: 2, slug: 'authentication', text: labels.authentication }] : []),
					{ depth: 2, slug: 'operations', text: labels.operations },
				]
			: [
					...(page.fields.length ? [{ depth: 2, slug: 'fields', text: labels.fields }] : []),
					...(page.example && page.fields.length ? [{ depth: 2, slug: 'example', text: labels.example }] : []),
					...(page.usedBy.length ? [{ depth: 2, slug: 'used-by', text: labels.usedBy }] : []),
				];

const frontmatter = {
	title: page.title,
	description: page.summary || undefined,
	tableOfContents: page.kind === 'operation' ? false : undefined,
};
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
	{
		page.kind === 'introduction' && (
			<div class="kiln-oa-intro">
				{page.version && (
					<p class="kiln-oa-version">
						<Badge text={`${labels.version} ${page.version}`} variant="default" />
					</p>
				)}
				<Parts parts={page.parts} />

				{page.servers.length > 0 && (
					<>
						<h2 id="base-url">{labels.baseUrl}</h2>
						{page.servers.map((s) => (
							<>
								<Code code={s.url} lang="txt" />
								{s.html && <p set:html={s.html} />}
							</>
						))}
					</>
				)}

				{page.auth.length > 0 && (
					<>
						<h2 id="authentication">{labels.authentication}</h2>
						<ul class="kiln-oa-auth">
							{page.auth.map((a) => (
								<li>
									<strong>{a.label}</strong>
									{a.html && <div set:html={a.html} />}
								</li>
							))}
						</ul>
					</>
				)}

				<h2 id="operations">{labels.operations}</h2>
				{page.groups.map((g) => (
					<section class="kiln-oa-group">
						<h3>{g.title}</h3>
						{g.html && <div set:html={g.html} />}
						<ul class="kiln-oa-oplist">
							{g.operations.map((o) => (
								<li>
									<a href={href(o.link)}>
										<span class="kiln-oa-method" data-method={o.method}>
											{method(o.method)}
										</span>
										<span class="kiln-oa-oplist-title">{o.title}</span>
										<code>{o.path}</code>
									</a>
								</li>
							))}
						</ul>
					</section>
				))}

				{page.specUrl && (
					<p class="kiln-oa-download">
						<a href={href(page.specUrl)} download>
							{labels.download}
						</a>
					</p>
				)}
			</div>
		)
	}

	{
		page.kind === 'operation' && (
			<div class="kiln-oa-op">
				<div class="kiln-oa-main">
					<div class="kiln-oa-endpoint">
						<span class="kiln-oa-method" data-method={page.method}>
							{method(page.method)}
						</span>
						<code>{page.path}</code>
						{page.deprecated && <Badge text={labels.deprecated} variant="caution" />}
					</div>
					<p class="kiln-oa-auth-line">
						{page.security.length === 0
							? labels.public
							: `${labels.authRequired}: ${page.security.map((alt) => alt.map((s) => s.label).join(' + ')).join(' / ')}`}
					</p>
					<Parts parts={page.parts} />

					{paramSections.map(([key, label]) => (
						<>
							<h2 id={`${key}-parameters`}>{label}</h2>
							<Fields fields={page.params[key]} labels={labels} />
						</>
					))}

					{page.body && (
						<>
							<h2 id="request-body">{labels.body}</h2>
							<p class="kiln-oa-content">
								<code>{page.body.contentType}</code>
								{page.body.type && <Type type={page.body.type} />}
								<span class={page.body.required ? 'kiln-oa-required' : 'kiln-oa-optional'}>
									{page.body.required ? labels.required : labels.optional}
								</span>
							</p>
							{page.body.html && <Fragment set:html={page.body.html} />}
							{page.body.fields.length > 0 && <Fields fields={page.body.fields} labels={labels} />}
						</>
					)}

					<h2 id="responses">{labels.responses}</h2>
					<div class="kiln-oa-responses">
						{page.responses.map((r) => (
							<details class="kiln-oa-response" open={r.ok}>
								<summary>
									<span class="kiln-oa-status" data-ok={String(r.ok)}>
										{r.status}
									</span>
									<span class="kiln-oa-response-desc" set:html={r.html.replace(/^<p>([\s\S]*)<\/p>$/, '$1') || labels.noContent} />
									{r.type && <Type type={r.type} />}
								</summary>
								{r.fields.length > 0 ? <Fields fields={r.fields} labels={labels} /> : r.contentType && <p class="kiln-oa-content"><code>{r.contentType}</code></p>}
							</details>
						))}
					</div>
				</div>

				<div class="kiln-oa-side" role="complementary" aria-label={`${labels.request} · ${labels.response}`}>
					<div class="kiln-oa-sticky">
						<p class="kiln-oa-side-title">{labels.request}</p>
						<Tabs syncKey="kiln-openapi-language">
							{page.samples.map((s) => (
								<TabItem label={s.label}>
									<Code code={s.code} lang={s.lang} />
								</TabItem>
							))}
						</Tabs>
						{examples.length > 0 && (
							<>
								<p class="kiln-oa-side-title">{labels.response}</p>
								{examples.length === 1 ? (
									<>
										<p class="kiln-oa-side-status">
											<span class="kiln-oa-status" data-ok={String(examples[0].ok)}>
												{examples[0].status}
											</span>
										</p>
										<Code code={examples[0].example} lang="json" />
									</>
								) : (
									<Tabs>
										{examples.map((r) => (
											<TabItem label={r.status}>
												<Code code={r.example} lang="json" />
											</TabItem>
										))}
									</Tabs>
								)}
							</>
						)}
					</div>
				</div>
			</div>
		)
	}

	{
		page.kind === 'schema' && (
			<div class="kiln-oa-schema">
				<Parts parts={page.parts} />
				{page.type && (
					<p class="kiln-oa-content">
						<Type type={page.type} />
					</p>
				)}
				{page.enum && (
					<p class="kiln-oa-field-meta">
						{labels.allowed}: <Fragment set:html={page.enum.map((v) => `<code>${v.replace(/</g, '&lt;')}</code>`).join(', ')} />
					</p>
				)}
				{page.fields.length > 0 && (
					<>
						<h2 id="fields">{labels.fields}</h2>
						<Fields fields={page.fields} labels={labels} />
					</>
				)}
				{page.example && page.fields.length > 0 && (
					<>
						<h2 id="example">{labels.example}</h2>
						<Code code={page.example} lang="json" />
					</>
				)}
				{page.usedBy.length > 0 && (
					<>
						<h2 id="used-by">{labels.usedBy}</h2>
						<ul class="kiln-oa-oplist">
							{page.usedBy.map((o) => (
								<li>
									<a href={href(o.link)}>
										<span class="kiln-oa-method" data-method={o.method}>
											{method(o.method)}
										</span>
										<span class="kiln-oa-oplist-title">{o.title}</span>
									</a>
								</li>
							))}
						</ul>
					</>
				)}
			</div>
		)
	}
</StarlightPage>
